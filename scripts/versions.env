# Pinned versions used by the deploy scripts. Terraform provider and module
# versions, the AMI release (system and Karpenter nodes) and the EKS add-ons
# are pinned in infra/; container base images in their Dockerfiles.

# Helm charts
LBC_CHART_VERSION="3.6.2"                 # eks/aws-load-balancer-controller
KARPENTER_VERSION="1.15.1"                # oci://public.ecr.aws/karpenter/karpenter
EFA_PLUGIN_CHART_VERSION="v0.5.35"        # eks/aws-efa-k8s-device-plugin
DYNAMO_VERSION="1.6.1"                    # dynamo-platform chart (helm.ngc.nvidia.com)

# Dynamo mocker / frontend image, mirrored to ECR with a SOCI index.
DYNAMO_PLANNER_SOURCE="nvcr.io/nvidia/ai-dynamo/dynamo-planner:1.6.1@sha256:7a3f07ce406c988c3c7ce30578fa1880831bb9408454daafdcb0a6f7ad1dabff"
DYNAMO_PLANNER_MIRROR_TAG="1.6.1-soci"

# Account that hosts EKS add-on images in most commercial Regions. Opt-in
# Regions use a different account; see the EKS "Amazon container image
# registries" documentation.
EKS_ADDON_REGISTRY_ACCOUNT="602401143452"

# Local ports for the SSM tunnels to the private Kubernetes API endpoints
# (router cluster first, then cells in cell-id order).
TUNNEL_BASE_PORT="9443"
